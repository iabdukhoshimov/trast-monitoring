[Unit]
Description=Loki Log Aggregation
After=network-online.target
Wants=network-online.target

[Service]
User={{ loki_user }}
Group={{ loki_group }}
Type=simple
Restart=on-failure
ExecStart={{ loki_install_dir }}/loki \
  -config.file={{ loki_config_dir }}/loki.yml

[Install]
WantedBy=multi-user.target
